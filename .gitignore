# macOS
.DS_Store

# .NET build output
bin/
obj/

# SNES ROMs — copyrighted commercial game data; never commit
*.sfc
*.smc

# Large sprite-sheet assets (import source material, not source code)
port/sprites/

# Tool-generated PNG outputs (palette/tile/sprite dumps written to cwd)
palette.png
tiles.png
sprite.png

# Downloaded libretro cores (binaries, fetched by port/emu/fetch-cores.sh)
port/emu/cores/

# V3 reference frames — frames of a copyrighted game, same rule as the ROM.
# Capture locally with --emu-golden and inspect before trusting.
port/emu/goldens/

# V3 save states — derived from a copyrighted ROM, same rule as goldens.
port/emu/states/

# Emulator working files left beside a test ROM when it is booted by hand
# (zsnes/SuperZSNES SRAM and save-state dirs). Derived from a copyrighted ROM,
# and regenerated on every boot — same rule as goldens.
*.srm
*.data.szsnes/

# Which build port/boot.sh last staged into the fixed dk-BOOT.sfc name.
# Local bookkeeping for one machine's emulator; regenerated on every stage.
port/dk-BOOT.what
