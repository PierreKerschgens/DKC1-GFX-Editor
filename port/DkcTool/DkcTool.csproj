<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DkcTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cross-platform imaging: replaces System.Drawing (Windows-only on modern .NET). -->
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <!-- Native libSkiaSharp for macOS (arm64 + x64). Needed for a console app on this Mac. -->
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.8" />
  </ItemGroup>

</Project>
